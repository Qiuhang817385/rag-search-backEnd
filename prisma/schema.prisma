generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 入库的一篇文档（全文 + 元数据）
model Document {
  id        String   @id @default(cuid())
  filename  String?
  rawText   String   @db.LongText
  createdAt DateTime @default(now())
  chunks    Chunk[]

  @@map("rag_documents")
}

/// 切片文本（步骤二再在同表加 embedding）
model Chunk {
  id         String   @id @default(cuid())
  documentId String
  /// 在文档内的顺序，从 0 开始
  chunkIndex Int
  content    String   @db.LongText
  createdAt  DateTime @default(now())
  /// OpenAI 兼容接口返回的浮点向量，维度与 .env DIMENSIONS 一致
  embedding  Json
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("rag_chunks")
}
