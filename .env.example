# 数据库
DATABASE_URL="mysql://user:password@host:3306/dbname"

# LLM
DEEPSEEK_API_KEY=
CHAT_API_KEY=
CHAT_MODEL=deepseek-v4-flash
CHAT_TEMPERATURE=0.3

# Ollama（可选）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TEMPERATURE=0.3

# 嵌入
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v4
DIMENSIONS=1536
BASE_URL=
EMBEDDING_APIKEY=

# R2 存储（可选）
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME_DOC=
R2_BUCKET_NAME_IMAGE=

# 服务
PORT=3025
FRONTEND_URL=http://localhost:3035

# Agent
AGENT_MAX_ITERATIONS=5
AGENT_MAX_HISTORY=20

# LangGraph agent-graph（CopilotKit → langgraph dev :8123）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_TEMPERATURE=0.3
LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123

# 本机 Shell 执行（迭代 0：仅 dev 建议开启）
# production 未设置时默认 false；非 production 未设置时默认 true
AGENT_SHELL_ENABLED=true
AGENT_SHELL_TIMEOUT_MS=15000
AGENT_SHELL_MAX_OUTPUT_CHARS=8000
# PowerShell 工作目录（建议使用项目根绝对路径）
AGENT_SHELL_CWD=
# 逗号分隔正则，命中即拒绝
AGENT_SHELL_BLOCK_PATTERNS=rm\s,del\s+/[fq],format\s,mkfs,>\s*,>>\s*,\|\s*cmd,-enc\b,Invoke-Expression
